# =====================================================
# PennyPilot Production Environment (PostgreSQL)
# =====================================================
# Copy this file to .env for production deployment
# =====================================================

APP_NAME=PennyPilot
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_TIMEZONE=Africa/Johannesburg
APP_URL=https://app.pennypilot.co.za

# =====================================================
# PostgreSQL Database (Docker Internal Network)
# =====================================================
# When Laravel runs in Docker alongside Postgres,
# use the container name as host (pennypilot-postgres)
# =====================================================
DB_CONNECTION=pgsql
DB_HOST=pennypilot-postgres
DB_PORT=5432
DB_DATABASE=pennypilot_prod
DB_USERNAME=pennypilot
DB_PASSWORD=your_secure_password_here

# For external connections (debugging from host):
# DB_HOST=localhost

# =====================================================
# PostgreSQL-specific Settings
# =====================================================
# Schema (default is 'public')
DB_SCHEMA=public

# SSL Mode (disable for internal Docker network)
DB_SSLMODE=prefer

# =====================================================
# Session & Cache (Redis recommended for production)
# =====================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# For Redis (if available):
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=pennypilot-redis
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# =====================================================
# Logging (Audit-Ready)
# =====================================================
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=90

# =====================================================
# Security
# =====================================================
BCRYPT_ROUNDS=12

# Sanctum (API tokens)
SANCTUM_STATEFUL_DOMAINS=app.pennypilot.co.za,localhost:9000

# CORS
CORS_ALLOWED_ORIGINS=https://app.pennypilot.co.za

# =====================================================
# Mail (for notifications)
# =====================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@pennypilot.co.za"
MAIL_FROM_NAME="${APP_NAME}"

# =====================================================
# External Services
# =====================================================
# Gemini AI (for invoice extraction via backend)
GEMINI_API_KEY=your_gemini_api_key

# n8n Webhook (for AI pipeline)
N8N_WEBHOOK_URL=http://ezepeze.dedicated.co.za:5678/webhook/pennypilot-invoice

# =====================================================
# Storage
# =====================================================
FILESYSTEM_DISK=local

# For S3/MinIO:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=af-south-1
# AWS_BUCKET=pennypilot
# AWS_USE_PATH_STYLE_ENDPOINT=false

# =====================================================
# Performance
# =====================================================
# OPcache (set in php.ini)
# Recommended: opcache.enable=1, opcache.memory_consumption=256

# Query caching
DB_CACHE_TTL=3600
